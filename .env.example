# ---------------------------------------------------------------------------
# Sidify — environment variables
#
# Copy this file to `.env.local` for development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deployment.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, Railway…).
# Needed at RUNTIME for: /api/library/*, /api/playlists, liked songs, listening
# history (/api/home "Recently played") and /api/health.
# The app BUILDS fine without it (the pool is created lazily on first query),
# and every library write falls back to localStorage — so a missing value
# degrades gracefully instead of breaking the deploy.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional — only for self-hosted lyrics mirrors. Production defaults are the
# public endpoints, so leaving these unset is the normal case.
# LRCLIB_BASE=https://lrclib.net
# LYRICS_OVH_BASE=https://api.lyrics.ovh

# ---------------------------------------------------------------------------
# Movies & Series (optional)
# ---------------------------------------------------------------------------
#
# Without a licensed catalogue configured, /movies and /series serve a clearly
# marked DEMO catalogue (fictional titles + generated artwork). Nothing streams.
#
# Provider selection: auto (default) | demo | tmdb
#   auto  – uses TMDb when a credential below is present, otherwise demo.
#   demo  – always the bundled demo catalogue.
MEDIA_PROVIDER=auto

# Official TMDb metadata API (https://developer.themoviedb.org). Use EITHER the
# v4 read access token (preferred) or the v3 API key. TMDb supplies metadata,
# artwork, official trailers and official "where to watch" links — not streams.
# TMDB_READ_ACCESS_TOKEN=
# TMDB_API_KEY=
# TMDB_LANGUAGE=en-US
# TMDB_REGION=IN

# Authorized playback only. JSON map of kind/slug -> HTTPS sources, for media the
# operator owns or a licensed provider explicitly allows streaming. Leave empty to
# show the trailer / official availability card instead of a player.
# Example:
# MEDIA_PLAYBACK_MANIFEST={"movie/demo-m-1":[{"url":"https://cdn.example.com/neon-monsoon/master.m3u8","type":"hls","label":"HD"}]}
