# ---------------------------------------------------------------------------
# Sidify — environment variables
#
# Copy this file to `.env.local` for development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deployment.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, Railway…).
# OPTIONAL: the app works fully without it — the library (liked songs, playlists,
# downloads, history, followed/blocked artists) then lives in the browser's
# localStorage only, and the library endpoints answer with an empty list.
#
# Set it to add a shared, cross-device library backed by Postgres. It is needed
# at RUNTIME for: /api/library/*, /api/playlists, liked songs, listening history
# (/api/home "Recently played") and /api/health.
# The app BUILDS fine without it (the pool is created lazily on first query), so a
# missing value degrades gracefully instead of breaking the deploy.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional — only for self-hosted lyrics mirrors. Production defaults are the
# public endpoints, so leaving these unset is the normal case.
# LRCLIB_BASE=https://lrclib.net
# LYRICS_OVH_BASE=https://api.lyrics.ovh

# ---------------------------------------------------------------------------
# Movies & Series (optional)
# ---------------------------------------------------------------------------
#
# Provider selection: auto | 4khdhub | merged | tmdb | archive | demo
#   auto / 4khdhub – Server-side 4KHDHub catalogue & mirror resolver (default).
#                    Fetches public pages server-side with strict host allowlist,
#                    private-IP blocking, byte caps and per-hop timeouts.
#   merged         – Explicit opt-in: TMDb metadata + Internet Archive items.
#   tmdb           – Explicit opt-in: TMDb metadata only (requires credential below).
#   archive        – Explicit opt-in: Internet Archive items only.
#   demo           – Explicit opt-in: bundled placeholder catalogue.
MEDIA_PROVIDER=auto

# The exclusive collection is always queried alongside the provider above — every
# search returns both catalogues' matches, and its titles are marked with an
# "Exclusive" badge. It needs no credentials and no separate server: the API is
# called from the existing serverless routes.
#
# Set to `0` to switch it off (search then returns the provider's results only).
MEDIA_EXCLUSIVE_COLLECTION=1

# Where the exclusive collection is fetched from.
#   (unset) / 1 – the browser asks /api/media/exclusive/ticket for signatures and
#                 reads the catalogue itself, so the upstream sees the user's
#                 address. Falls back to the server relay automatically when the
#                 catalogue's CORS policy refuses.
#   0           – always read through the server relay (the pre-existing path).
# NEXT_PUBLIC_EXCLUSIVE_DIRECT=1

# Outbound identity for server-side upstream requests.
#   mobile  – the reversed Android client identity (default, most compatible).
#   browser – a coherent Chrome 141 identity (user-agent + sec-ch-ua*).
# This is a fingerprint setting only: it does not and cannot change the request's
# origin IP. See docs/exclusive-collection.md.
# MEDIA_UPSTREAM_HEADER_PROFILE=mobile

# Optional egress relay in front of the upstream (e.g. a Cloudflare Worker):
# upstream URLs are sent as `<base>?u=<encoded-url>`. Useful when the deployment's
# own datacenter range is blocked and the browser path is unavailable.
# MEDIA_UPSTREAM_RELAY_URL=

# Optional override when the upstream catalogue domain rotates (must be https:// public host):
# FOURKHDHUB_BASE_URL=https://4khdhub.one
# FOURKHDHUB_EXTRA_HOSTS=

# Official TMDb metadata API (https://developer.themoviedb.org). Used only when
# `MEDIA_PROVIDER=tmdb` or `MEDIA_PROVIDER=merged`.
# TMDB_READ_ACCESS_TOKEN=
# TMDB_API_KEY=
# TMDB_LANGUAGE=en-US
# TMDB_REGION=IN

# Optional operator stream manifest: JSON map of kind/slug -> verified HTTPS MP4/WebM/HLS streams.
# Example:
# MEDIA_PLAYBACK_MANIFEST={"movie/hub-sample-movie-1":[{"url":"https://cdn.example.com/sample/master.m3u8","type":"hls","label":"1080p HLS"}]}
